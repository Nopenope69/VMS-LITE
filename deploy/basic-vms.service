[Unit]
Description=Basic VMS - Video Management System Daemon
Documentation=https://github.com/Nopenope69/VMS-LITE
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/basic-vms
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300
Restart=always

[Install]
WantedBy=multi-user.target
