# Optional HTTPS front for Basic VMS (run Caddy on the appliance host).
# The control plane serves the UI, REST API, WebSocket event feed and the
# authenticated media proxy on one port, so everything is proxied as-is.
# Set TRUST_PROXY=true in .env so client IPs are recorded correctly.
#
# Replace :80 with your domain (e.g. vms.example.com) to get automatic HTTPS.

:80 {
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy 127.0.0.1:3000 {
        # Live video and playback are long-lived streams
        flush_interval -1
    }
}
