# Basic VMS Environment Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
# When PostgreSQL is not running, Basic VMS automatically falls back
# to its high-speed in-memory store for instant evaluation.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vms_lite?schema=public"

# MediaMTX Media Plane Server
MEDIAMTX_API_URL="http://127.0.0.1:9997"
MEDIAMTX_WHEP_BASE_URL="http://localhost:8889"
MEDIAMTX_HLS_BASE_URL="http://localhost:8888"
MEDIAMTX_PLAYBACK_BASE_URL="http://localhost:9996"

# Storage Directories
RECORDINGS_PATH="./recordings"
EXPORTS_PATH="./exports"

# WebRTC STUN Server
STUN_SERVER_URL="stun:stun.l.google.com:19302"
