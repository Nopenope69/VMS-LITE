# ---- Required for docker compose ----
POSTGRES_USER=vms_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=basic_vms

# ---- Recommended ----
# >= 32 random characters. If unset, a secret is generated and stored in the database.
JWT_SECRET=
# Timezone used to evaluate recording schedules
TZ=Asia/Kolkata
# Address remote viewers use to reach this appliance (advertised for WebRTC)
PUBLIC_HOST=
# Base URL used in alert e-mails / webhooks
PUBLIC_BASE_URL=
# Initial admin password on a fresh database (default admin123, change at first login)
ADMIN_INITIAL_PASSWORD=

# ---- Optional ----
# TURN relay (docker compose --profile turn): hostname/IP of the TURN server and shared secret
TURN_SERVER_HOST=
TURN_SECRET=
# Days to keep the event history (default 90)
EVENT_RETENTION_DAYS=
# Set to true when running behind a reverse proxy (Caddy/nginx) so client IPs are logged
TRUST_PROXY=
BASIC_VMS_LICENSE=

# ---- Local development without docker (npm run dev) ----
# DATABASE_URL=postgresql://vms_user:vms_password@localhost:5432/basic_vms?schema=public
# RECORDINGS_PATH=./data/recordings
# USE_MOCK_DB=true   # in-memory demo data, nothing is persisted
# Comma-separated origins allowed to call the API cross-origin (default: none)
CORS_ORIGINS=
