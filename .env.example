# ---- Required for docker compose ----
POSTGRES_USER=vms_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=basic_vms

# ---- Recommended ----
# >= 32 random characters. If unset, a secret is generated and stored in the database.
JWT_SECRET=
# Default timezone for recording schedules and alert/report timestamps.
# The timezone chosen in the first-boot wizard takes precedence once set.
TZ=Asia/Kolkata
# Address remote viewers use to reach this appliance (advertised for WebRTC)
PUBLIC_HOST=
# Base URL used in alert e-mails / webhooks
PUBLIC_BASE_URL=
# Initial admin password on a fresh database (default admin123, change at first login)
ADMIN_INITIAL_PASSWORD=

# ---- Optional ----
# TURN relay (docker compose --profile turn): hostname/IP of the TURN server and shared secret
TURN_SERVER_HOST=
TURN_SECRET=
# Days to keep the event history (default 90)
EVENT_RETENTION_DAYS=
# Daily configuration backups (sites, cameras, users; not recordings) in the app's
# data volume, listed at /api/system/backups. Set AUTO_BACKUP=false to disable.
AUTO_BACKUP=
# Number of daily backups to keep (default 14)
BACKUP_RETENTION_COUNT=
# Behind a reverse proxy: true trusts X-Forwarded-* only from a proxy on this host
# (the https profile); for a proxy elsewhere, give its IP(s), comma-separated.
TRUST_PROXY=

# ---- HTTPS (docker compose profile "https", see deploy/Caddyfile) ----
# COMPOSE_PROFILES=https
# HTTPS_DOMAIN=vms.example.com
# E-mail for a Let's Encrypt certificate, or "internal" for LAN/VPN-only installs
# HTTPS_TLS=ops@example.com
# Keep plain HTTP off the network when HTTPS is on
# APP_HOST=127.0.0.1
BASIC_VMS_LICENSE=

# ---- Local development without docker (npm run dev) ----
# DATABASE_URL=postgresql://vms_user:vms_password@localhost:5432/basic_vms?schema=public
# RECORDINGS_PATH=./data/recordings
# USE_MOCK_DB=true   # in-memory demo data, nothing is persisted
# Comma-separated origins allowed to call the API cross-origin (default: none)
CORS_ORIGINS=
